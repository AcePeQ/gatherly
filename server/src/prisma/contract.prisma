// use prisma-8
model User {
  id                  Int                        @id @default(autoincrement())
  email               String                     @unique
  name                String
  passwordHash        String
  createdAt           TimestamptzString          @default(now())
  updatedAt           temporal.updatedAtString()

  passwordResetTokens PasswordResetToken[]
  tripMemberships     TripMember[]
}

model PasswordResetToken {
  id        Int                @id @default(autoincrement())
  tokenHash String             @unique
  expiresAt TimestamptzString
  usedAt    TimestamptzString?
  createdAt TimestamptzString  @default(now())
  userId    Int
  user      User               @relation(fields:[userId], references:[id])
}

model Trip {
  id          Int                        @id @default(autoincrement())
  name        String
  place       String
  startDate   DateString
  endDate     DateString
  description String?
  coverUrl    String?
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  members     TripMember[]

  @@check(expression: "\"startDate\" <= \"endDate\"", name: "trip_dates_valid")
}

model TripMember {
  tripId   Int
  userId   Int
  role     TripRole          @default(MEMBER)
  joinedAt TimestamptzString @default(now())
  trip     Trip              @relation(fields:[tripId], references:[id])
  user     User              @relation(fields:[userId], references:[id])

  @@id([tripId, userId])
  @@index([tripId], unique: true, where: "\"role\" = 'OWNER'", name: "trip_single_owner")
  @@index([userId])
}

enum TripRole {
  MEMBER
  OWNER
}
