<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>Reset your Gatherly password</title>
    <style>
      @media only screen and (max-width: 620px) {
        .email-shell {
          padding: 24px 12px !important;
        }

        .email-card {
          border-radius: 16px !important;
        }

        .email-content {
          padding: 32px 24px 28px !important;
        }

        .email-header {
          padding: 22px 24px !important;
        }

        .email-title {
          font-size: 27px !important;
          line-height: 34px !important;
        }

        .button-cell,
        .button-link {
          display: block !important;
          width: 100% !important;
          box-sizing: border-box !important;
        }
      }
    </style>
  </head>
  <body style="margin: 0; padding: 0; background-color: #faf8f5; color: #172b40; font-family: Arial, Helvetica, sans-serif; -webkit-text-size-adjust: 100%;">
    <div style="display: none; max-height: 0; overflow: hidden; opacity: 0; color: transparent;">
      Use this secure link to reset your Gatherly password. It expires in 15 minutes.
    </div>

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width: 100%; background-color: #faf8f5;">
      <tr>
        <td class="email-shell" align="center" style="padding: 48px 20px;">
          <table class="email-card" role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width: 100%; max-width: 600px; background-color: #ffffff; border: 1px solid #dce2e8; border-radius: 20px; box-shadow: 0 12px 40px rgba(23, 43, 64, 0.10); overflow: hidden;">
            <tr>
              <td class="email-header" style="padding: 24px 40px; background-color: #eaf2fa; border-bottom: 1px solid #dce2e8;">
                <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                  <tr>
                    <td width="38" height="38" align="center" valign="middle" style="width: 38px; height: 38px; border-radius: 12px; background-color: #1d4ed8; color: #ffffff; font-size: 20px; line-height: 38px; font-weight: 700;">
                      G
                    </td>
                    <td style="padding-left: 12px; color: #173d67; font-size: 23px; line-height: 28px; font-weight: 700; letter-spacing: -0.4px;">
                      Gatherly
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td class="email-content" style="padding: 40px 48px 36px;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                  <tr>
                    <td align="center" style="padding-bottom: 22px;">
                      <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                        <tr>
                          <td width="54" height="54" align="center" valign="middle" style="width: 54px; height: 54px; border: 2px solid #93c5fd; border-radius: 50%; background-color: #eaf2fa; color: #173d67; font-size: 23px; line-height: 54px;">
                            &#128273;
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>

                  <tr>
                    <td align="center">
                      <h1 class="email-title" style="margin: 0; color: #172b40; font-size: 30px; line-height: 38px; font-weight: 700; letter-spacing: -0.6px;">
                        Reset your password
                      </h1>
                      <p style="margin: 12px 0 0; color: #536577; font-size: 16px; line-height: 25px;">
                        Hi {{name}}, we received a request to reset the password for your Gatherly account.
                      </p>
                    </td>
                  </tr>

                  <tr>
                    <td align="center" style="padding: 28px 0 24px;">
                      <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 auto;">
                        <tr>
                          <td class="button-cell" align="center" bgcolor="#1d4ed8" style="border-radius: 8px; background-color: #1d4ed8; box-shadow: 0 4px 12px rgba(29, 78, 216, 0.20);">
                            <a class="button-link" href="{{resetPasswordURL}}" target="_blank" style="display: inline-block; padding: 14px 26px; color: #ffffff; font-size: 16px; line-height: 20px; font-weight: 700; text-decoration: none; border-radius: 8px;">
                              Reset password
                            </a>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>

                  <tr>
                    <td style="padding: 14px 16px; background-color: #eaf2fa; border: 1px solid #bfdbfe; border-radius: 10px;">
                      <p style="margin: 0; color: #173d67; font-size: 14px; line-height: 21px; text-align: center;">
                        For your security, this link expires in <strong>15 minutes</strong>. Please use it before then.
                      </p>
                    </td>
                  </tr>

                  <tr>
                    <td style="padding-top: 26px;">
                      <p style="margin: 0; color: #536577; font-size: 14px; line-height: 22px;">
                        If the button does not work, copy and paste this link into your browser:
                      </p>
                      <p style="margin: 7px 0 0; font-size: 13px; line-height: 20px; word-break: break-all;">
                        <a href="{{resetPasswordURL}}" target="_blank" style="color: #1d4ed8; text-decoration: underline;">{{resetPasswordURL}}</a>
                      </p>
                    </td>
                  </tr>

                  <tr>
                    <td style="padding-top: 24px;">
                      <p style="margin: 0; color: #536577; font-size: 14px; line-height: 22px;">
                        Didn't request a password reset? You can safely ignore this email — your password will stay unchanged.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td align="center" style="padding: 22px 32px; background-color: #f7f9fb; border-top: 1px solid #dce2e8;">
                <p style="margin: 0; color: #7b8998; font-size: 12px; line-height: 18px;">
                  Gatherly &middot; Plan together. Travel better.
                </p>
                <p style="margin: 4px 0 0; color: #7b8998; font-size: 12px; line-height: 18px;">
                  This is an automated security message. Please do not reply.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
